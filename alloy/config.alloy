logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "payment_logs" {
  path_targets = [
    {
      __path__ = "/var/log/payment/api.log",
      job      = "payment-backend",
      service  = "payment-backend",
      log_type = "api",
    },
    {
      __path__ = "/var/log/payment/scheduler.log",
      job      = "payment-backend",
      service  = "payment-backend",
      log_type = "scheduler",
    },
  ]
}

loki.source.file "payment_logs" {
  targets               = local.file_match.payment_logs.targets
  forward_to            = [loki.process.payment_logs.receiver]
  tail_from_end         = true
  legacy_positions_file = "/var/lib/alloy/data/positions.yaml"
}

loki.process "payment_logs" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      application = "payment-backend",
      environment = "prod",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }

  external_labels = {
    cluster = "payment-prod",
  }
}
